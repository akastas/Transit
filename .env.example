# Port on which the proxy server will run
PORT=5000

# Data source for departures:
#   direct      -> read Roma Mobilita's GTFS + GTFS-RT feeds directly (default, no API key)
#   transitland -> use the legacy Transitland REST proxy (requires TRANSITLAND_APIKEY)
DATA_SOURCE=direct

# How far ahead (in minutes) to list departures. Default 60, so the Commute Radar
# shows roughly the next hour of buses. Lower it for an "imminent arrivals only" board.
LOOKAHEAD_MIN=60

# Transitland API Key (obtain from https://www.transit.land/) - only needed when DATA_SOURCE=transitland
TRANSITLAND_APIKEY=YOUR_TRANSITLAND_API_KEY

# Transitland Feed ID for Rome ATAC / Roma TPL / Trenitalia
TRANSITLAND_FEED=f-sr-atac~romatpl~trenitalia

# Default Stop IDs around Porta S. Giovanni & Carlo Felice (Reordered).
# These are only the server-side defaults: any browser can build its own board
# from the ⚙️ "Imposta" panel (stored in localStorage, queried via
# /api/transit?stops=...), so other users don't need to edit this file.
STOP_ID_1=71223      # Porta S. Giovanni (Card 1)
STOP_ID_2=72100      # Porta S. Giovanni / Carlo Felice (Card 2 - Default Direction)
STOP_ID_3=81953      # Carlo Felice (Card 3)
STOP_ID_4=70335      # Porta S. Giovanni (Card 4)
STOP_ID_2_ALT=81993  # Porta S. Giovanni / Carlo Felice (Card 2 - Opposite Direction Toggle)
STOP_ID_METRO=CP22     # San Giovanni (Metro C to Colosseo Platform)

